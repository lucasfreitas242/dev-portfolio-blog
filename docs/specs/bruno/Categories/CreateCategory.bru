meta {
  name: Create Category
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "DevOps & Cloud",
    "slug": "devops-cloud",
    "isFeatured": false
  }
}

tests {
  test("Status code is 201 Created or 409 Conflict", function() {
    expect([201, 409]).to.include(res.getStatus());
  });

  if (res.getStatus() === 201) {
    test("Returns created category with valid slug", function() {
      const data = res.getBody();
      expect(data.id).to.be.a('string');
      expect(data.slug).to.equal("devops-cloud");
    });
  }
}
