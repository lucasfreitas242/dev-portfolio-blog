meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "contato@lucasefreitas.dev",
    "password": "Admin@123!"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (data.token) {
      bru.setEnvVar("authToken", data.token);
    }
  }
}

tests {
  test("Status code is 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Returns JWT token and admin info", function() {
    const data = res.getBody();
    expect(data.token).to.be.a('string');
    expect(data.email).to.equal("contato@lucasefreitas.dev");
    expect(data.name).to.equal("Lucas Freitas");
    expect(data.expiresAt).to.be.a('string');
  });
}
